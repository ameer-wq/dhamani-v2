{
  "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx"],
  "generatedExclusions": ["packages/db/generated"],
  "buildOutputExclusions": [
    "apps/api/dist",
    "apps/mobile/.expo",
    "apps/mobile/.spec000-export",
    "apps/admin/.next",
    "packages/domain/dist",
    "packages/contracts/dist",
    "packages/config/dist",
    "packages/db/dist",
    "packages/observability/dist"
  ],
  "spec001Prefixes": ["apps/api/src/spec001/", "packages/domain/src/spec001/"],
  "spec001Barrels": ["packages/domain/src/index.ts"],
  "spec001Models": [
    "AgreementRevision",
    "ApplicationIdempotencyRecord",
    "Deal",
    "DealAgreementAuditEvent",
    "DealPartySlot",
    "RevisionResponse"
  ],
  "spec001Commands": [
    "AcceptCurrentRevision",
    "BindCounterpartyPrincipal",
    "CreateFormalDeal",
    "ExpireInvitationIfDue",
    "ProposeChanges",
    "RejectCurrentRevision",
    "WithdrawInvitation",
    "WithdrawNegotiation"
  ],
  "production": [
    "apps/admin/app/layout.tsx",
    "apps/admin/app/page.tsx",
    "apps/admin/next-env.d.ts",
    "apps/api/src/app.controller.ts",
    "apps/api/src/app.module.ts",
    "apps/api/src/bootstrap.ts",
    "apps/api/src/main.ts",
    "apps/api/src/spec001/application-readiness.ts",
    "apps/api/src/spec001/commands/accept-current-revision.ts",
    "apps/api/src/spec001/commands/bind-counterparty-principal.ts",
    "apps/api/src/spec001/commands/create-formal-deal.ts",
    "apps/api/src/spec001/commands/expire-invitation-if-due.ts",
    "apps/api/src/spec001/commands/propose-changes.ts",
    "apps/api/src/spec001/commands/reject-current-revision.ts",
    "apps/api/src/spec001/commands/shared.ts",
    "apps/api/src/spec001/commands/withdraw.ts",
    "apps/api/src/spec001/crypto.ts",
    "apps/api/src/spec001/database.ts",
    "apps/api/src/spec001/idempotency-store.ts",
    "apps/api/src/spec001/kernel.ts",
    "apps/api/src/spec001/readiness.ts",
    "apps/api/src/spec001/reads.ts",
    "apps/api/src/spec001/repository.ts",
    "apps/mobile/App.tsx",
    "packages/config/src/index.ts",
    "packages/contracts/src/index.ts",
    "packages/db/src/index.ts",
    "packages/domain/src/index.ts",
    "packages/domain/src/spec001/deal-types.ts",
    "packages/domain/src/spec001/errors.ts",
    "packages/domain/src/spec001/idempotency.ts",
    "packages/domain/src/spec001/integrity.ts",
    "packages/domain/src/spec001/json/decimal.ts",
    "packages/domain/src/spec001/json/jcs.ts",
    "packages/domain/src/spec001/json/number-serialization.ts",
    "packages/domain/src/spec001/json/strict-json.ts",
    "packages/domain/src/spec001/ports.ts",
    "packages/domain/src/spec001/readiness.ts",
    "packages/domain/src/spec001/state.ts",
    "packages/domain/src/spec001/terms.ts",
    "packages/observability/src/index.ts"
  ],
  "developmentOnly": ["packages/testkit/src/index.ts"]
}
